#!/usr/bin/env bash
# =============================================================================
#  ctool 環境設定ファイル
#  このファイルを env という名前でコピーして編集してください。
#  cp env.sample env
# =============================================================================

# ノードのホームディレクトリ（cardano-node のデータ・鍵ファイルが置かれる場所）
# 例: /home/ubuntu/cardano-node
NODE_HOME="${HOME}/cardano-node"

# cold-keys の保管ディレクトリ（エアギャップマシン上のパス）
COLDKEYS_DIR="${HOME}/cold-keys"

# ネットワーク設定
# mainnet の場合:
NETWORK="--mainnet"
# プレビューテストネットの場合:
# NETWORK="--testnet-magic 2"

# リレーノードの IP アドレス（プール情報更新時に使用）
RELAY1_IP=""

# リレーノードのポート番号（デフォルト: 6000）
POOL_PORT="6000"

# 表示言語 / UI language: ja（日本語）または en（English）
# アプリ内のメインメニュー [L] からも切り替えできます。
# Display language: "ja" (Japanese) or "en" (English). Toggle in-app via [L] on the main menu.
CTOOL_LANG="ja"
